#!/bin/bash
# Chạy với quyền root sau khi chép file: đăng ký & bật bộ gõ cho người dùng đang đăng nhập,
# để dùng được ngay, không cần log out.
APP="/Library/Input Methods/VietIME.app"
USER_NAME=$(stat -f%Su /dev/console)
USER_ID=$(id -u "$USER_NAME" 2>/dev/null)
killall VietIME 2>/dev/null || true
if [[ -n "$USER_ID" && "$USER_NAME" != "root" ]]; then
  # Chạy như người dùng (đăng ký bộ gõ là theo từng user); giới hạn 10 giây cho chắc.
  launchctl asuser "$USER_ID" sudo -u "$USER_NAME" "$APP/Contents/MacOS/VietIME" --register &
  PID=$!
  ( sleep 10; kill "$PID" 2>/dev/null ) &
  wait "$PID" 2>/dev/null || true
fi
exit 0
